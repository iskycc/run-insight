# Docker Compose deployment template.
# Copy this file to .env and fill every empty secret before starting the stack.
#
# Generate URL-safe random secrets, for example:
#   openssl rand -hex 24

MARIADB_DATABASE=run_insight
MARIADB_USER=run_insight
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Must use the same database name, user, and password as above.
# Shape: mysql://run_insight:<MARIADB_PASSWORD>@db:3306/run_insight
DATABASE_URL=

# Recommended: at least 32 random bytes. Example generator: openssl rand -hex 48
JWT_SECRET=

# One-time proof required by the first-run /setup guide.
# Generate with: openssl rand -hex 32
INSTANCE_SETUP_TOKEN=

# Separate secret for the external due-reminder scheduler.
CRON_SECRET=

# Base64-encoded 32-byte AES key for encrypting Webhook signing secrets.
# Generate with: openssl rand -base64 32
WEBHOOK_ENCRYPTION_KEY=

# Set to the exact number of trusted reverse proxies in front of the app.
# Keep 0 when the container is reached directly.
TRUST_PROXY_HOPS=0

# Timezone used for user-visible dates and datetimes.
NEXT_PUBLIC_TIME_ZONE=Asia/Shanghai
