generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  password     String
  role         Role           @default(EDITOR)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  importRecords ImportRecord[]
  auditLogs    AuditLog[]
  caseUpdates  CaseResult[]   @relation("CaseUpdater")
}

model Project {
  id        String       @id @default(cuid())
  name      String       @unique
  archived  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  stages    TestStage[]
  cases     CaseResult[]
  batches   BatchScope[]
  importRecords ImportRecord[]
  apiKeys   ApiKey[]
}

model TestStage {
  id        String       @id @default(cuid())
  projectId String
  name      String
  archived  Boolean      @default(false)
  project   Project      @relation(fields: [projectId], references: [id])
  batches   BatchScope[]
  cases     CaseResult[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([projectId, name])
}

model BatchScope {
  id          String       @id @default(cuid())
  projectId   String
  testStageId String
  name        String
  archived    Boolean      @default(false)
  project     Project      @relation(fields: [projectId], references: [id])
  stage       TestStage    @relation(fields: [testStageId], references: [id])
  cases       CaseResult[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([projectId, testStageId, name])
}

model CaseResult {
  id               String     @id @default(cuid())
  caseNo           String
  name             String
  resultSummary    String
  logUrl           String?
  projectId        String
  testStageId      String
  batchScopeId     String
  assignee         String?
  progressCategory String?
  rootCause        String?
  mrOrTicket       String?
  notes            String?    @db.Text
  assetSaved       Boolean    @default(false)
  updatedBy        String?
  project          Project    @relation(fields: [projectId], references: [id])
  stage            TestStage  @relation(fields: [testStageId], references: [id])
  batchScope       BatchScope @relation(fields: [batchScopeId], references: [id])
  updater          User?      @relation("CaseUpdater", fields: [updatedBy], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([projectId, testStageId, batchScopeId, caseNo])
  @@index([projectId, resultSummary])
  @@index([testStageId, resultSummary])
  @@index([batchScopeId, resultSummary])
  @@index([batchScopeId, progressCategory])
  @@index([projectId, progressCategory])
  @@index([assetSaved])
}

model ImportRecord {
  id            String   @id @default(cuid())
  projectId     String
  importType    String
  fileName      String
  totalRows     Int
  importedCount Int
  errorCount    Int
  errors        Json?
  userId        String
  project       Project  @relation(fields: [projectId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())

  @@index([projectId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  changes    Json?
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

model ApiKey {
  id          String   @id @default(cuid())
  projectId   String
  keyHash     String
  description String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id])

  @@index([keyHash])
}
