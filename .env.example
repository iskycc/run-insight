# Local development only. Do not reuse these credentials for Docker or production.
# Database connection (MySQL / MariaDB)
DATABASE_URL=mysql://root:root123@127.0.0.1:3306/run_insight

# Use a unique random value even in development when possible.
# Production startup rejects a missing JWT_SECRET.
JWT_SECRET=replace-with-a-random-local-secret

# One-time proof required by the first-run /setup guide. Use at least 32 characters.
# Generate with: openssl rand -hex 32
INSTANCE_SETUP_TOKEN=replace-with-a-random-setup-token

# Use false only for explicit plain-HTTP testing. Keep true behind HTTPS.
COOKIE_SECURE=false

# Protects POST /api/cron/due-reminders. Required only when running reminders.
CRON_SECRET=replace-with-a-separate-random-local-secret

# Base64-encoded 32-byte key used to encrypt project Webhook signing secrets.
# Generate with: openssl rand -base64 32
WEBHOOK_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Number of reverse-proxy hops that are controlled by your deployment.
# Keep 0 for direct local development; forwarded IP headers are ignored.
TRUST_PROXY_HOPS=0

# Timezone used for user-visible dates and datetimes. Invalid values fall back to Asia/Shanghai.
NEXT_PUBLIC_TIME_ZONE=Asia/Shanghai

# Optional local demo seed credentials. Production seeding is disabled by default.
SEED_ADMIN_PASSWORD=admin123
SEED_VIEWER_PASSWORD=viewer123
